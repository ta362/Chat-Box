{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Anonymous serial post document",
      "type": "object",
      "properties": {
        "serialNumber": { "type": "number" },
        "content": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "number" },
        "authorToken": { "type": "string" },
        "likesCount": { "type": "number" },
        "targetLikes": { "type": "number" },
        "commentsCount": { "type": "number" },
        "targetComments": { "type": "number" },
        "likedBy": { "type": "array" },
        "reactions": { "type": "object" },
        "tag": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "passcodeHash": { "type": "string" },
        "privateHint": { "type": "string" },
        "firstUnlockedAt": { "type": "number" }
      },
      "required": ["serialNumber", "content", "createdAt", "authorToken"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on an anonymous post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "number" },
        "authorToken": { "type": "string" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" }
      },
      "required": ["postId", "content", "createdAt", "authorToken"]
    },
    "Meta": {
      "title": "Meta",
      "description": "Atomic serial counter metadata",
      "type": "object",
      "properties": {
        "lastSerialNumber": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["lastSerialNumber"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of anonymous posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Subcollection of comments on a post"
    },
    "/meta/{metaId}": {
      "schema": "Meta",
      "description": "Metadata for atomic serial numbering"
    }
  }
}
